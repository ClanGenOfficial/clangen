        "not_mates",
        "parent/child",
        "not_parent",
        "child/parent",
        "not_child",
        "mentor/app",
        "not_mentor",
        "app/mentor",
        "not_app",
        "fancies",
        "adores",
        "loves",
        "loathes",
        "hates",
        "dislikes",
        "knows_of",
        "likes",
        "enjoys",
        "cherishes",
        "resents",
        "envies",
        "begrudges",
        "acknowledges",
        "praises",
        "respects",
        "admires",
        "discredits",
        "distrusts",
        "doubts",
        "observes",
        "listens_to",
        "trusts",
        "confides_in",
        "runs_from",
        "fears",
        "avoids",
        "considers",
        "relates_to",
        "understands",
        "knows_deeply",
        "fancies_only",
        "adores_only",
        "delights_in_only",
        "abhors_only",
        "hates_only",
        "dislikes_only",
        "knows_of_only",
        "likes_only",
        "enjoys_only",
        "loves_only",

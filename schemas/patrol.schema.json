{
  "$defs": {
    "BiomeEnum": {
      "enum": [
        "mountainous",
        "plains",
        "forest",
        "beach",
        "wetlands",
        "desert",
        "any"
      ],
      "title": "BiomeEnum",
      "type": "string"
    },
    "CanHaveStatEnum": {
      "enum": [
        "p_l",
        "r_c",
        "app1",
        "app2",
        "not_pl",
        "not_rc",
        "not_pl_rc",
        "any",
        "adult",
        "app",
        "healer"
      ],
      "title": "CanHaveStatEnum",
      "type": "string"
    },
    "DeadCats": {
      "enum": [
        "some_lives",
        "all_lives"
      ],
      "title": "DeadCats",
      "type": "string"
    },
    "GatherCat": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatherCatEnum"
        },
        {
          "pattern": "^n_c:[0-9]+$",
          "type": "string"
        }
      ],
      "title": "GatherCat"
    },
    "GatherCatEnum": {
      "enum": [
        "m_c",
        "r_c",
        "p_l",
        "s_c",
        "app1",
        "app2",
        "app3",
        "app4",
        "app5",
        "app6",
        "clan",
        "some_clan",
        "patrol",
        "multi"
      ],
      "title": "GatherCatEnum",
      "type": "string"
    },
    "HistoryText": {
      "properties": {
        "reg_death": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Death history text for non-leaders. Whole sentence.",
          "title": "Reg Death"
        },
        "lead_death": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Death history text for leaders. Sentence fragment.",
          "title": "Lead Death"
        },
        "scar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scar history. Whole sentence.",
          "title": "Scar"
        }
      },
      "title": "HistoryText",
      "type": "object"
    },
    "Illness": {
      "enum": [
        "seizure",
        "diarrhea",
        "fleas",
        "greencough",
        "kittencough",
        "an infected wound",
        "carrionplace disease",
        "redcough",
        "running nose",
        "whitecough",
        "yellowcough",
        "a festering wound",
        "heat stroke",
        "heat exhaustion",
        "stomachache",
        "constant nightmares",
        "grief stricken",
        "malnourished",
        "starving"
      ],
      "title": "Illness",
      "type": "string"
    },
    "Injury": {
      "enum": [
        "claw-wound",
        "bite-wound",
        "cat bite",
        "beak bite",
        "snake bite",
        "rat bite",
        "tick bites",
        "blood loss",
        "broken jaw",
        "broken bone",
        "mangled leg",
        "dislocated joint",
        "joint pain",
        "sprain",
        "mangled tail",
        "bruises",
        "cracked pads",
        "sore",
        "phantom pain",
        "scrapes",
        "small cut",
        "torn pelt",
        "torn ear",
        "frostbite",
        "recovering from birth",
        "water in their lungs",
        "burn",
        "severe burn",
        "shock",
        "lingering shock",
        "shivering",
        "dehydrated",
        "head damage",
        "damaged eyes",
        "quilled by a porcupine",
        "broken back",
        "poisoned",
        "bee sting",
        "headache",
        "severe headache",
        "pregnant",
        "battle_injury",
        "minor_injury",
        "blunt_force_injury",
        "hot_injury",
        "cold_injury",
        "big_bite_injury",
        "small_bite_injury",
        "beak_bite",
        "rat_bite",
        "sickness"
      ],
      "title": "Injury",
      "type": "string"
    },
    "InjuryItem": {
      "properties": {
        "cats": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GatherCat"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which cats are injured.",
          "title": "Cats"
        },
        "injuries": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Injury"
                  },
                  {
                    "$ref": "#/$defs/Illness"
                  },
                  {
                    "$ref": "#/$defs/PermCondition"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pool of injuries to draw from.",
          "title": "Injuries"
        },
        "scars": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Scar"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pool of scars to draw from in Classic. Currently non-functional.",
          "title": "Scars"
        },
        "no_results": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True if the injury \"got\" message does not show up in patrol summary.",
          "title": "No Results"
        }
      },
      "title": "InjuryItem",
      "type": "object"
    },
    "NewCat": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/NewCatTag"
          },
          {
            "pattern": "^status:(.+)$",
            "type": "string"
          },
          {
            "pattern": "^age:(.+)$",
            "type": "string"
          },
          {
            "pattern": "^backstory:(.+)$",
            "type": "string"
          },
          {
            "pattern": "^parent:([,0-9]+)$",
            "type": "string"
          },
          {
            "pattern": "^adoptive:([_,0-9a-zA-Z]+)$",
            "type": "string"
          },
          {
            "pattern": "^mate:([_,0-9a-zA-Z]+)$",
            "type": "string"
          }
        ]
      },
      "title": "NewCat",
      "type": "array"
    },
    "NewCatTag": {
      "enum": [
        "male",
        "female",
        "can_birth",
        "new_name",
        "old_name",
        "kittypet",
        "loner",
        "rogue",
        "clancat",
        "meeting",
        "exists",
        "unknown",
        "litter",
        "dead"
      ],
      "title": "NewCatTag",
      "type": "string"
    },
    "Outcome": {
      "properties": {
        "text": {
          "description": "Displayed outcome text.",
          "title": "Text",
          "type": "string"
        },
        "weight": {
          "description": "Controls how common an outcome is.",
          "title": "Weight",
          "type": "integer"
        },
        "exp": {
          "description": "Base exp gain.",
          "title": "Exp",
          "type": "integer"
        },
        "stat_skill": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Skill"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Makes this a stat outcome which can occur if a stat cat can be found.",
          "title": "Stat Skill"
        },
        "stat_trait": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Trait"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Makes this a stat outcome which can occur if a stat cat can be found.",
          "title": "Stat Trait"
        },
        "can_have_stat": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CanHaveStatEnum"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides default behavior or adds additional requirements for stat_cat picking.",
          "title": "Can Have Stat"
        },
        "prey": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PreyEnum"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates how much prey each cat brings back.",
          "title": "Prey"
        },
        "herbs": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/scripts__models__common__herb__Herb"
                  },
                  {
                    "$ref": "#/$defs/scripts__models__patrol__herb__Herb"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates which herbs will be given.",
          "title": "Herbs"
        },
        "lost_cats": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GatherCat"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates which cats will become lost.",
          "title": "Lost Cats"
        },
        "dead_cats": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GatherCat"
                  },
                  {
                    "$ref": "#/$defs/DeadCats"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates which cats will die.",
          "title": "Dead Cats"
        },
        "injury": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InjuryItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates which cats get injured and how.",
          "title": "Injury"
        },
        "history_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Controls the history-text for scars and death."
        },
        "relationships": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Relationship"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indicates effect on cat relationships.",
          "title": "Relationships"
        },
        "new_cat": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/NewCat"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Adds new cat(s), either joining the clan or as outside cats. The {index} value corresponds to their index value on this list (e.g. n_c:0 refers to the first cat in this list).",
          "title": "New Cat"
        },
        "art": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of outcome-specific art, without file extension (no .png). If no art is specified, the intro art will be used.",
          "title": "Art"
        },
        "art_clean": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of non-gore outcome-specific art, without file extension (no .png). Adding a clean version of the art marks the normal version as containing gore.",
          "title": "Art Clean"
        },
        "outsider_rep": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How much outsider reputation will change. Can be positive or negative.",
          "title": "Outsider Rep"
        },
        "other_clan_rep": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How much reputation with other Clan will change. Can be positive or negative.",
          "title": "Other Clan Rep"
        }
      },
      "required": [
        "text",
        "weight",
        "exp"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "PatrolSchemaItem": {
      "properties": {
        "patrol_id": {
          "description": "Unique string used to identify the patrol.",
          "title": "Patrol Id",
          "type": "string"
        },
        "biome": {
          "description": "Controls the biome(s) the patrol appears in",
          "items": {
            "$ref": "#/$defs/BiomeEnum"
          },
          "title": "Biome",
          "type": "array"
        },
        "season": {
          "description": "Controls the season(s) the patrol appears in.",
          "items": {
            "$ref": "#/$defs/SeasonEnum"
          },
          "title": "Season",
          "type": "array"
        },
        "types": {
          "description": "Controls the type of patrol.",
          "items": {
            "$ref": "#/$defs/PatrolType"
          },
          "title": "Types",
          "type": "array"
        },
        "tags": {
          "description": "Tags are used for some filtering purposes, and some odd-and-ends. Tags never affect outcome.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PatrolTag"
              },
              {
                "pattern": "^clan:(.+)$",
                "type": "string"
              }
            ]
          },
          "title": "Tags",
          "type": "array"
        },
        "patrol_art": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The name of displayed patrol art file, without any file extension (no .png).",
          "title": "Patrol Art"
        },
        "patrol_art_clean": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If patrol_art contains gore, this line can hold a clean version. The existence of a non-empty string in this parameter marks the patrol art in \"patrol_art\" as explicit.",
          "title": "Patrol Art Clean"
        },
        "min_cats": {
          "description": "Minimum total number of cats for this patrol.",
          "title": "Min Cats",
          "type": "integer"
        },
        "max_cats": {
          "description": "Maximum total number of cats for this patrol",
          "title": "Max Cats",
          "type": "integer"
        },
        "min_max_status": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allows specification of the minimum and maximum number of specific types of cats that are allowed on the patrol.",
          "title": "Min Max Status"
        },
        "weight": {
          "description": "Controls how common a patrol is. Normal patrols would be around 20. Lower numbers are less common and higher numbers are more common.",
          "title": "Weight",
          "type": "integer"
        },
        "chance_of_success": {
          "description": "Controls chance to succeed. Higher number is higher chance to succeed.",
          "title": "Chance Of Success",
          "type": "integer"
        },
        "relationship_status": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RelationshipStatus"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dictates what relationships m_c must have towards r_c. Do not use this section if there is no r_c in the event.",
          "title": "Relationship Status"
        },
        "pl_skill_constraint": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Skill"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only allow this patrol if the patrol leader (p_l) meets at least one of these skill requirements.",
          "title": "Pl Skill Constraint"
        },
        "intro_text": {
          "description": "The text that displays when the patrol first starts.",
          "title": "Intro Text",
          "type": "string"
        },
        "decline_text": {
          "description": "The text that displays if the patrol is declined (do not proceed)",
          "title": "Decline Text",
          "type": "string"
        },
        "success_outcomes": {
          "items": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Success Outcomes",
          "type": "array"
        },
        "fail_outcomes": {
          "items": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Fail Outcomes",
          "type": "array"
        },
        "antag_success_outcomes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Outcome"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Antag Success Outcomes"
        },
        "antag_fail_outcomes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Outcome"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Antag Fail Outcomes"
        }
      },
      "required": [
        "patrol_id",
        "biome",
        "season",
        "types",
        "tags",
        "patrol_art",
        "min_cats",
        "max_cats",
        "weight",
        "chance_of_success",
        "intro_text",
        "decline_text",
        "success_outcomes",
        "fail_outcomes"
      ],
      "title": "PatrolSchemaItem",
      "type": "object"
    },
    "PatrolTag": {
      "enum": [
        "romance",
        "rom_two_apps",
        "disaster",
        "new_cat",
        "halloween",
        "april_fools",
        "new_years",
        "cruel_season",
        "all_mentored",
        "app1_mentored",
        "app2_mentored",
        "app3_mentored",
        "app4_mentored",
        "app5_mentored",
        "app6_mentored"
      ],
      "title": "PatrolTag",
      "type": "string"
    },
    "PatrolType": {
      "enum": [
        "hunting",
        "herb_gathering",
        "border",
        "training"
      ],
      "title": "PatrolType",
      "type": "string"
    },
    "PermCondition": {
      "enum": [
        "crooked jaw",
        "lost a leg",
        "born without a leg",
        "weak leg",
        "twisted leg",
        "lost their tail",
        "born without a tail",
        "paralyzed",
        "raspy lungs",
        "wasting disease",
        "blind",
        "one bad eye",
        "failing eyesight",
        "partial hearing loss",
        "deaf",
        "constant joint pain",
        "seizure prone",
        "allergies",
        "constantly dizzy",
        "recurring shock",
        "lasting grief",
        "persistent headaches"
      ],
      "title": "PermCondition",
      "type": "string"
    },
    "PreyEnum": {
      "enum": [
        "very_small",
        "small",
        "medium",
        "large",
        "huge"
      ],
      "title": "PreyEnum",
      "type": "string"
    },
    "Relationship": {
      "properties": {
        "cats_from": {
          "description": "The cat's whose relationship values are being edited. You are changing how the \"cats_from\" feels.",
          "items": {
            "$ref": "#/$defs/GatherCat"
          },
          "title": "Cats From",
          "type": "array"
        },
        "cats_to": {
          "description": "The target of the relationship. You are changing how \"cats_from\" feels about \"cats_to\".",
          "items": {
            "$ref": "#/$defs/GatherCat"
          },
          "title": "Cats To",
          "type": "array"
        },
        "mutual": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Controls if the relation effect will be applied in both directions.",
          "title": "Mutual"
        },
        "values": {
          "description": "Controls which relationship values are affected.",
          "items": {
            "$ref": "#/$defs/Value"
          },
          "title": "Values",
          "type": "array"
        },
        "amount": {
          "description": "Exact amount the relationship value will be affected. Can be positive or negative.",
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "cats_from",
        "cats_to",
        "values",
        "amount"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "RelationshipStatus": {
      "$ref": "#/$defs/RelationshipStatusEnum",
      "title": "RelationshipStatus"
    },

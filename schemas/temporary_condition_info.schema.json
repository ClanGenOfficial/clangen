    "TemporaryConditionInfoSchemaItem": {
      "additionalProperties": false,
      "properties": {
        "tags": {
          "description": "Tag this condition to link it with other conditions for the purpose of creating pools for events to apply, or otherwise utilizing common-groups of conditions within the code.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "severity": {
          "description": "Severity of the condition. For permanent conditions, major and severe conditions can cause the cat to retire early. For temporary conditions, major and minors conditions will prevent the cat from working.",
          "enum": [
            "major",
            "minor",
            "severe"
          ],
          "title": "Severity",
          "type": "string"
        },
        "mortality": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Percent chance for this condition to kill the cat. Can be left empty if the condition is not fatal.",
          "propertyNames": {
            "$ref": "#/$defs/Age"
          },
          "title": "Mortality",
          "type": "object"
        },
        "immune_system_effect": {
          "description": "Effect on the percent chance that this cat will be infected by a different condition. This float will be added to the percent chance, thus increasing the cat's likely-hood to contract an infectious condition.",
          "title": "Immune System Effect",
          "type": "number"
        },
        "progression": {
          "additionalProperties": {
            "$ref": "#/$defs/ProgressionDict"
          },
          "description": "The conditions that this condition can progress into (i.e. be replaced by). Can be left empty if the condition has no progressions.",
          "propertyNames": {
            "$ref": "#/$defs/ConditionEnum"
          },
          "title": "Progression",
          "type": "object"
        },
        "risks": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Extra conditions that can be gained while the cat has this condition. Float is the percentage chance to apply this condition.",
          "propertyNames": {
            "$ref": "#/$defs/ConditionEnum"
          },
          "title": "Risks",
          "type": "object"
        },
        "treatment_strength": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Herb"
            },
            "type": "array"
          },
          "description": "Lists of herbs that can be used for treatment of this condition. The 1, 2, 3 keys correspond to the strength of the herbs. Can be left empty if no herbs can be used to treat this condition.",
          "propertyNames": {
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "title": "Treatment Strength",
          "type": "object"
        },
        "possible_scars": {
          "description": "List of scars this condition can give upon healing.",
          "items": {
            "$ref": "#/$defs/Scar"
          },
          "title": "Possible Scars",
          "type": "array"
        },
        "duration": {
          "description": "How many moons the cat will have this condition.",
          "title": "Duration",
          "type": "integer"
        },
        "infectiousness": {
          "description": "Percentage chance that the cat will infect others with this condition. Can be set to 0.0 if the condition cannot infect others.",
          "title": "Infectiousness",
          "type": "number"
        },
        "side_effect": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Extra conditions that can also be applied as a 'bonus' when this condition is given to the cat. Float is the percentage chance that the condition will be applied.",
          "propertyNames": {
            "$ref": "#/$defs/ConditionEnum"
          },
          "title": "Side Effect",
          "type": "object"
        },
        "is_complication": {
          "description": "If condition is a complication of another condition (i.e. infection is a complication) and cannot be given on it's own.",
          "title": "Is Complication",
          "type": "boolean"
        }
      },
      "required": [
        "severity",
        "mortality",
        "immune_system_effect",
        "progression",
        "risks",
        "treatment_strength",
        "duration",
        "infectiousness",
        "side_effect"
      ],
      "title": "TemporaryConditionInfoSchemaItem",
      "type": "object"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/TemporaryConditionInfoSchemaItem"
  },
  "description": "Temporary condition info in Clan Generator.",
  "propertyNames": {
